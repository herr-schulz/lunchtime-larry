{
  "name": "lunchtime-larry",
  "version": "1.0.0",
  "private": true,
  "description": "Weekly canteen menus for Arabellapark — scraped Mondays, served as a static lunch board.",
  "type": "module",
  "scripts": {
    "scrape": "tsx scrape/index.ts",
    "dev": "npx --yes serve site -p 4173",
    "test": "vitest run",
