{
  "name": "lunchtime-larry",
  "version": "1.0.0",
  "private": true,
  "description": "Weekly canteen menus for Arabellapark — scraped Mondays, served as a static lunch board.",
  "type": "module",
  "scripts": {
    "scrape": "tsx scrape/index.ts",
    "scrape:gate": "tsx scrape/shouldRun.ts",
    "dev": "npx --yes serve site -p 4173",
    "deploy": "node scripts/fetch-aufrufe.mjs && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only database",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only database --project demo-larry \"vitest run --config vitest.rules.config.ts\"",
    "calendar": "node scripts/vote-calendar.mjs",
    "typecheck": "tsc --noEmit",
    "stamp": "node scripts/stamp-assets.mjs",
    "icons": "node scripts/make-larry-assets.mjs",
    "og": "node scripts/make-og-image.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "linkedom": "^0.18.12",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "firebase": "^13.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
