    "icons": "node scripts/make-larry-assets.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "linkedom": "^0.18.12",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
